# claude-code-telegram config for Bryan Johnson AI.
# Keep the real file outside this repo, e.g. ~/.config/bryan-telegram/.env

# Must stay "local". "development" forces a 600s timeout, "production" a $5 cost cap.
ENVIRONMENT=local

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_BOT_USERNAME=YourBotUsername

# Absolute path to your clone of this repo. The bot lives here and can't leave it.
APPROVED_DIRECTORY=/path/to/bryan-johnson-ai

# Your numeric Telegram ID (ask @userinfobot). Comma-separate to add more people.
ALLOWED_USERS=111111111

# Without this the framework falls back to a 2024 model. opus or sonnet.
CLAUDE_MODEL=opus

USE_SDK=false
CLAUDE_TIMEOUT_SECONDS=1800
# The code default of 10 can cut a search-heavy answer short.
CLAUDE_MAX_TURNS=200

# On a Claude subscription there is no per-token cost, so a huge number turns the cap off.
# 0 does not mean off, 0 blocks everything. On API credits set a real dollar limit.
CLAUDE_MAX_COST_PER_USER=1000000

# Quiet: you see only the final answer.
VERBOSE_LEVEL=0
ENABLE_TELEMETRY=false
ENABLE_MCP=false
ENABLE_FILE_UPLOADS=true

# Web search to check the protocol, file tools to keep your profile.
# Leave Monitor and ToolSearch in: a denied tool can kill the whole answer.
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash,WebSearch,WebFetch,Monitor,ToolSearch
